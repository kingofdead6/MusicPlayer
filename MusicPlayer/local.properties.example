# Copy to local.properties and fill in. local.properties is git-ignored.
# Android SDK location (set by Android Studio automatically).
sdk.dir=/path/to/Android/sdk

# The Hugging Face API key for AI playlists is entered in the app under
# Settings -> AI Playlists. Nothing below is required.

# Optional overrides for the OpenAI-compatible chat-completions endpoint. Leave them out to
# use the Hugging Face router. Base URL only - the client appends /chat/completions itself.
# A key entered in Settings takes precedence over LLM_API_KEY.
#LLM_BASE_URL=https://router.huggingface.co/v1
#LLM_API_KEY=
#LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional override for the speech-to-text endpoint used by song analysis. Leave it out to
# use the Hugging Face Whisper deployment. It takes raw audio bytes and answers with
# {"text": "..."}; the key above (or the one entered in Settings) authenticates it.
#STT_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3
